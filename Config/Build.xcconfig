// Both targets must use the same signing team and registered App Group.
COLORLIGHT_BUNDLE_BASE = com.colorlight.ledsync
COLORLIGHT_APP_GROUP = group.com.colorlight.ledsync
IPHONEOS_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 5.0
MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 2
CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_STRICT_CONCURRENCY = minimal
// Set DEVELOPMENT_TEAM in Xcode or on the command line for signed builds.
